class Animal{
	void eat(){
		System.out.println("Animal is eating");
	}
}
class Mammal extends Animal{
	void breathe(){
		System.out.println("Mammal is breathing");
	}
}
class Dog extends Mammal{
	void bark(){
		System.out.println("Dog is barking");
	}
}

class MultiInher{
	public static void main(String[] args){
		Dog d = new Dog();
		d.eat();
		d.breathe();
		d.bark();
	}
}

